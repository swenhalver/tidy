{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["../web/*"],
      "@tidy/gpt-plugin/widget": ["./src/types/gpt-plugin-widget.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../web/*.d.ts",
    "../web/lib/design/vectorisation/*.d.ts"
  ]
}
